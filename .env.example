# Copy to .env and fill in. Never commit .env.

# PostgreSQL
POSTGRES_USER=arena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arena
DATABASE_URL=postgresql://arena:change-me@postgres:5432/arena

# Redis (Celery broker, used from stage 6)
REDIS_URL=redis://redis:6379/0

# Model providers (only needed from stage 1)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
